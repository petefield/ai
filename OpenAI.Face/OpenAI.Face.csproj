<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>


  <ItemGroup>
    <None Remove="face-closed-blink.txt" />
    <None Remove="face-closed.txt" />
    <None Remove="face-open.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.21.0" />
	<PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.0-preview.1.25120.3" />

  </ItemGroup>
	<ItemGroup>

		<Resource Include="face-closed-blink.txt">
		  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Resource>

		<Resource Include="face-open.txt">
		  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Resource>

		<Resource Include="face-closed.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

</Project>
